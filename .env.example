# Path relative to the my-tv repository root (or an absolute path in local overrides).
IPTV_SOURCE_DIR=../iptv-mb

# Server-only secret used to authenticate and encrypt short-lived, catalog-bound
# HLS gateway capabilities. Use at least 32 random characters. Keep this value
# stable across server restarts or capabilities already held by open tabs become
# invalid. Never use NEXT_PUBLIC_*.
PLAYBACK_GATEWAY_SECRET=replace-with-at-least-32-random-characters

# Exact browser origin allowed on playback gateway responses.
PLAYBACK_ALLOWED_ORIGIN=http://localhost:3000

# Published enrichment is downloaded only by `pnpm data:update:published` and
# cached under ignored data/cache/. Ordinary dev/build commands do not fetch it.
