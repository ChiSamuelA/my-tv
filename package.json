{
  "name": "my-tv",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "lint": "pnpm --dir apps/web lint",
    "test": "tsx --test apps/web/lib/server/catalog/store.test.ts apps/web/lib/content/search-params.test.ts apps/web/lib/server/watch-model.test.ts apps/web/lib/server/related-channels.test.ts apps/web/lib/server/playback/capability.test.ts apps/web/lib/server/playback/catalog-binding.test.ts apps/web/lib/server/playback/header-policy.test.ts apps/web/lib/server/playback/network-safety.test.ts apps/web/lib/server/playback/hls-rewrite.test.ts",
    "typecheck": "tsc --noEmit -p scripts/tsconfig.json && pnpm --dir apps/web exec tsc --noEmit",
    "data:update": "tsx scripts/data/update.ts",
    "data:update:published": "tsx scripts/data/update.ts --published",
    "data:validate": "tsx scripts/data/validate.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
